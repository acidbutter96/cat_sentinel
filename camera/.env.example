# Camera connection (TP-Link Tapo C200)
CAMERA_HOST=192.168.1.50

# RTSP/ONVIF stream credentials -- the local "Camera Account" set in the
# Tapo app under Advanced Settings > Camera Account (NOT your TP-Link
# cloud account).
CAMERA_RTSP_PORT=554
CAMERA_RTSP_USER=admin
CAMERA_RTSP_PASSWORD=changeme
# /stream1 = HD (main), /stream2 = SD (sub)
CAMERA_RTSP_PATH=/stream1
CAMERA_RTSP_TRANSPORT=tcp

# PTZ control (pytapo) -- your TP-Link cloud account email/password, or on
# some firmware the same local Camera Account as above.
# Set to false to skip the Tapo connection entirely (PTZ routes 503,
# ptz_* event commands just log) -- e.g. while sorting out credentials.
PTZ_ENABLED=true
TAPO_CONTROL_USER=
TAPO_CONTROL_PASSWORD=
# Empirical pytapo moveMotor() units-per-degree; re-tune for your unit.
PTZ_UNITS_PER_DEGREE=10.0

# HTTP server
HTTP_PORT=8000
# Live MJPEG only: keeps recordings at their original source quality.
LIVE_JPEG_QUALITY=60
MJPEG_FRAME_INTERVAL_SECONDS=0.1

# Events / webhooks
EVENTS_API_KEY=

# Recordings
RECORDING_SCAN_INTERVAL_SECONDS=300
RECORDINGS_DIR=./recordings

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jortan_camera

# Logging
LOG_LEVEL=INFO
