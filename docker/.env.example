POSTGRES_USER=cat_sentinel
POSTGRES_PASSWORD=cat_sentinel
POSTGRES_PORT=5432

# Matching DATABASE_URL for each backend's .env, using the databases created
# by init-databases.sh:
#   cat-sentinel/.env -> DATABASE_URL=postgresql+asyncpg://cat_sentinel:cat_sentinel@localhost:5432/cat_sentinel
#   camera/.env       -> DATABASE_URL=postgresql+asyncpg://cat_sentinel:cat_sentinel@localhost:5432/camera
